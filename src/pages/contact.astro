---
import Layout from "@/layouts/Layout.astro";
import ContactForm from "@/components/contact-form";
import CVSection from "@/components/cv-section";

const channels = [
  { k: "Email", v: "work@saefulrohman.dev", href: "mailto:work@saefulrohman.dev" },
  { k: "GitHub", v: "@XenchinRyu7", href: "https://github.com/XenchinRyu7" },
  { k: "LinkedIn", v: "saeful-rohman", href: "https://www.linkedin.com/in/saeful-rohman" },
  { k: "Location", v: "Indonesia · UTC+7", href: "" },
];
---

<Layout
  title="Contact — Saeful Rohman"
  description="Get in touch with Saeful Rohman for collaborations, projects, or conversations about mobile, fullstack, games and AI."
>
  <section class="pt-32 md:pt-40">
    <div class="mx-auto max-w-[1400px] px-5 md:px-10">
      <p class="label text-[var(--mute)]">§ Contact</p>
      <h1 class="display-1 mt-6 text-[clamp(3rem,11vw,9rem)]">
        Let’s make
        <br />
        something
        <br />
        <span class="not-italic">real.</span>
      </h1>
      <p class="mt-10 max-w-2xl text-balance text-lg leading-relaxed text-[var(--ink)]/75 md:text-xl">
        Send a short brief — what you’re making, when you need it, and any
        links. I’ll reply within 48 hours with a clear yes, no, or a
        thoughtful counter-proposal.
      </p>
    </div>
  </section>

  <section class="mx-auto mt-16 grid max-w-[1400px] grid-cols-12 gap-6 px-5 md:px-10">
    <div class="col-span-12 md:col-span-5">
      <div class="border border-[var(--ink)] bg-[var(--bone)]">
        <div class="flex items-center justify-between border-b border-[var(--ink)] px-6 py-4">
          <span class="chip bg-[var(--bone)]">Direct channels</span>
          <span class="font-mono text-[10px] uppercase tracking-[0.22em] text-[var(--mute)]">
            v1.0
          </span>
        </div>
        <dl class="divide-y divide-[var(--rule)]">
          {channels.map((c) => (
            <div
              key={c.k}
              class="flex items-center justify-between gap-4 px-6 py-5"
            >
              <dt class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--mute)]">
                {c.k}
              </dt>
              {c.href ? (
                <a
                  href={c.href}
                  target={c.href.startsWith("http") ? "_blank" : undefined}
                  rel="noreferrer"
                  class="font-serif text-lg italic underline-offset-4 hover:underline"
                >
                  {c.v}
                </a>
              ) : (
                <dd class="font-serif text-lg italic">{c.v}</dd>
              )}
            </div>
          ))}
        </dl>
      </div>

      <div class="mt-6 border border-[var(--ink)] bg-[var(--acid)] p-6">
        <p class="font-mono text-[11px] uppercase tracking-[0.22em]">
          Availability
        </p>
        <p class="mt-3 font-serif text-2xl italic leading-tight">
          Accepting 1–2 new build partnerships this quarter.
        </p>
      </div>
    </div>

    <div class="col-span-12 md:col-span-7 md:pl-10">
      <ContactForm client:load />
    </div>
  </section>

  <div class="mt-16 md:mt-24">
    <CVSection client:visible />
  </div>
</Layout>
